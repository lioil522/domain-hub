{
  "name": "domain-hub-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:selfhost": "npm run typecheck && vite build --mode selfhost",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.359.0",
    "qrcode.react": "4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "react-test-renderer": "18.3.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/node": "26.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
